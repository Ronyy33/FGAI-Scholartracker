# ScholarTrack runtime settings. Copy to .env (never commit .env) or set in your host's
# dashboard. Every value is optional; the defaults are shown. There are no secrets: the app
# has no login and must therefore only ever serve synthetic or properly authorised data.

# Port used by the Docker image (most hosts set this automatically).
PORT=8000

# Model bundle, demo data, aggregate reports and built dashboard.
SCHOLARTRACK_BUNDLE_DIR=models/serving
SCHOLARTRACK_DATA_DIR=data/synthetic
SCHOLARTRACK_REPORTS_DIR=reports
SCHOLARTRACK_FRONTEND_DIST=frontend/dist

# Upload limits for POST /api/predict/batch.
SCHOLARTRACK_MAX_UPLOAD_BYTES=2097152
SCHOLARTRACK_MAX_ROWS=5000

# Comma-separated origins allowed to call the API from another domain (empty = same origin only).
SCHOLARTRACK_CORS_ORIGINS=

# Optional prediction-history log (counts only, no identifiers; kept 90 days). Off by default.
SCHOLARTRACK_ENABLE_HISTORY=false
SCHOLARTRACK_HISTORY_DB=data/history.sqlite3
